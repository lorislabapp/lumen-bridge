<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Lumen Hub — Developer ID / local build of the Bridge (scheme "LumenHub",
  configuration "Hub"). No App Sandbox: the HomeKit accessory server must
  accept incoming connections and the Homebridge / llama.cpp sidecars run as
  child processes. Same identity, iCloud container and keychain groups as
  the App Store build (LumenBridge.entitlements), which stays sandboxed.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.lorislabapp.lumenbridge</string>
	</array>
	<key>com.apple.developer.icloud-container-environment</key>
	<string>Production</string>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)com.lorislab.lumenforfrigate.Lumen-for-Frigate</string>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.lorislabapp.lumenbridge</string>
		<string>$(AppIdentifierPrefix)com.lorislab.lumen.automation</string>
	</array>
</dict>
</plist>
