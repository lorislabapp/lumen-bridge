<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	 Sandbox is ON because App Store Connect rejects TestFlight uploads
	 with code 90296 ("App sandbox not enabled") otherwise. Phase 5 v0.2
	 (HomeKit cameras via Homebridge sidecar) needs `sandbox=false` to
	 spawn `/opt/homebrew/bin/node` — that feature works only on a
	 separate Developer ID direct-download build. The toggle ships in
	 the TestFlight build but the subprocess will fail at runtime when
	 sandboxed; we surface that as an error in Settings UI.
	 -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!--
	 `com.apple.security.network.server`: required since 1.1. The App Store
	 build now runs an in-process HomeKit Accessory Protocol server
	 (Bouke/HAP, Shared/HomeKit/HAPBridgeManager.swift) that publishes
	 `_hap._tcp` on Bonjour and accepts connections from Apple Home hubs for
	 the motion sensors and zone-alert doorbells. 1.0 was flagged under
	 Guideline 2.4.5(i) (submission fba1a7a8…) because it declared this key
	 with no server feature; 1.1 has one. Homebridge/Node/ffmpeg cameras
	 stay out of this build (compiled only with LUMEN_HUB).
	 -->
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.lorislabapp.lumenbridge</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)com.lorislab.lumenforfrigate.Lumen-for-Frigate</string>
	<!-- Keychain access groups: required when sandboxed so Bridge can
	     read/write its own MQTT password entry. The team-id prefix is
	     mandatory for iCloud Keychain sync (kSecAttrSynchronizable). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.lorislabapp.lumenbridge</string>
		<string>$(AppIdentifierPrefix)com.lorislab.lumen.automation</string>
	</array>
</dict>
</plist>
