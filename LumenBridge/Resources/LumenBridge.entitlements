<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	 Sandbox is ON because App Store Connect rejects TestFlight uploads
	 with code 90296 ("App sandbox not enabled") otherwise. Phase 5 v0.2
	 (HomeKit cameras via Homebridge sidecar) needs `sandbox=false` to
	 spawn `/opt/homebrew/bin/node` — that feature works only on a
	 separate Developer ID direct-download build. The toggle ships in
	 the TestFlight build but the subprocess will fail at runtime when
	 sandboxed; we surface that as an error in Settings UI.
	 -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!--
	 `com.apple.security.network.server` was previously declared with a view
	 to Phase 5 v0.2 (HomeKit / HAP accessory advertising on Bonjour). That
	 phase ships only as a direct-download Developer ID build, NOT through
	 the App Store, so the App Store build does not need the entitlement.
	 Apple App Review (Submission ID fba1a7a8-c9f9-4df8-bfac-5377bf6196bb,
	 Guideline 2.4.5(i)) flagged it because the Mac App Store binary has no
	 matching server functionality. Removed 2026-05-06.
	 -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.lorislabapp.lumenbridge</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
	<!-- Keychain access groups: required when sandboxed so Bridge can
	     read/write its own MQTT password entry. The team-id prefix is
	     mandatory for iCloud Keychain sync (kSecAttrSynchronizable). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.lorislabapp.lumenbridge</string>
	</array>
</dict>
</plist>
