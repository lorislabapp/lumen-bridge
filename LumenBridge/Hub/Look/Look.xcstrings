      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "7 jours"
          }
        }
      }
    },
    "Allow lights, TVs, shutters or doors above to check them on a camera.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez des lumières, télés, volets ou portes plus haut pour les vérifier sur une caméra."
          }
        }
      }
    },
    "Area for %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zone pour %@"
          }
        }
      }
    },
    "Ask the vision model when unsure": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demander au modèle de vision en cas de doute"
          }
        }
      }
    },
    "Camera": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caméra"
          }
        }
      }
    },
    "Camera snapshot. Drag to draw the box.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Image de la caméra. Faites glisser pour dessiner la zone."
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler"
          }
        }
      }
    },
    "Check as": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifier comme"
          }
        }
      }
    },
    "Check on camera": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifier sur la caméra"
          }
        }
      }
    },
    "Check on camera after each action": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifier sur la caméra après chaque action"
          }
        }
      }
    },
    "Drag a box around the device itself: the lamp shade, the TV screen, the window, the door.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessinez la zone autour de l'appareil lui-même : l'abat-jour, l'écran de la télé, la fenêtre, la porte."
          }
        }
      }
    },
    "Draw a box around the device on one camera. After a command, Lumen looks once the device has had time to move. It says “checked” only when it sees it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessinez une zone autour de l'appareil sur une caméra. Après une commande, Lumen regarde quand l'appareil a eu le temps de bouger. Il dit « vérifié » seulement s'il le voit."
          }
        }
      }
    },
    "Draw area on camera": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessiner la zone sur la caméra"
          }
        }
      }
    },
