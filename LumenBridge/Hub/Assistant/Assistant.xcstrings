    "Done": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fait"
          }
        }
      }
    },
    "Each line is chained to the one before it, so an edit made outside Lumen Hub shows up.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque ligne est liée à la précédente : une modification faite hors de Lumen Hub se voit."
          }
        }
      }
    },
    "Enter the Home Assistant address (http://…:8123).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez l’adresse de Home Assistant (http://…:8123)."
          }
        }
      }
    },
    "Failed": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec"
          }
        }
      }
    },
    "Get devices": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récupérer les appareils"
          }
        }
      }
    },
    "Heard by:": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entendue par :"
          }
        }
      }
    },
    "Heating, camera privacy: only for a recognised adult voice.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chauffage, confidentialité des caméras : seulement pour une voix d’adulte reconnue."
          }
        }
      }
    },
    "Home Assistant": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Home Assistant"
          }
        }
      }
    },
    "Home Assistant did not answer.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Home Assistant n’a pas répondu."
          }
        }
      }
    },
    "Home Assistant refused the token.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Home Assistant a refusé le jeton."
          }
        }
      }
    },
    "How to talk to it": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment lui parler"
          }
        }
      }
    },
    "Invalid address": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresse non valide"
          }
        }
      }
    },
    "Last result": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dernier résultat"
          }
        }
      }
    },
    "Lets the assistant use this device": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet à l’assistant d’utiliser cet appareil"
          }
        }
      }
    },
    "Lights, TV, music, shutters, plugs: done right away, for anyone.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumières, télé, musique, volets, prises : fait tout de suite, pour tout le monde."
          }
        }
      }
    },
    "Listening": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À l’écoute"
          }
        }
      }
    },
    "Lock": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouiller"
          }
        }
      }
    },
    "Locks, alarm and garage need a recognised adult voice.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Serrures, alarme et garage demandent une voix d’adulte reconnue."
          }
        }
      }
    },
    "Locks, alarm, garage: never done from a camera. You get a request to confirm with Face ID on your iPhone.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Serrures, alarme, garage : jamais depuis une caméra. Vous recevez une demande à confirmer avec Face ID sur votre iPhone."
          }
        }
      }
    },
    "Long-lived access token": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeton d’accès longue durée"
          }
        }
      }
    },
    "Lower": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baisser"
          }
        }
      }
    },
    "Lumen AI assistant. Everything runs on this Mac. Only accepted commands are written to the log below; nothing else heard is kept.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assistant IA Lumen. Tout se passe sur ce Mac. Seules les commandes acceptées sont écrites dans le journal ci-dessous ; rien d’autre de ce qui est entendu n’est gardé."
          }
        }
      }
    },
    "Lumen Pro is needed to turn this on.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumen Pro est nécessaire pour l’activer."
          }
        }
      }
    },
    "Microphones": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Micros"
          }
        }
      }
    },
    "Natural (no wake word)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Naturel (sans mot d’appel)"
          }
        }
      }
    },
    "Natural mode needs a known voice.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode naturel demande une voix connue."
          }
        }
      }
    },
    "Natural mode needs a person seen in the room.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode naturel demande une personne vue dans la pièce."
          }
        }
      }
    },
    "Natural mode only does harmless things (lights, TV, shutters). It needs a known voice and a person seen in that room. “Lumen, …” still works for the rest.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode naturel ne fait que des choses sans risque (lumières, télé, volets). Il faut une voix connue et une personne vue dans la pièce. « Lumen, … » marche toujours pour le reste."
          }
        }
      }
    },
    "Natural mode only does harmless things.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode naturel ne fait que des choses sans risque."
          }
        }
      }
    },
    "Needs a recognised adult voice.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il faut une voix d’adulte reconnue."
          }
        }
      }
    },
    "New devices are off until you allow them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveaux appareils restent désactivés jusqu’à votre accord."
          }
        }
      }
    },
    "New room": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nouvelle pièce"
          }
        }
      }
    },
    "No AAC audio on this camera stream": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d’audio AAC sur le flux de cette caméra"
          }
        }
      }
    },
    "No camera yet. Check the Frigate connection.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune caméra pour l’instant. Vérifiez la connexion à Frigate."
          }
        }
      }
    },
    "No room": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune pièce"
          }
        }
      }
    },
    "Not allowed from a camera.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Interdit depuis une caméra."
          }
        }
      }
    },
    "Not checked": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non vérifié"
          }
        }
      }
    },
    "Not said to the assistant.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas adressé à l’assistant."
          }
        }
      }
    },
    "Nothing yet.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien pour l’instant."
          }
        }
      }
    },
    "Notify the paired iPhones of what was done": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévenir les iPhone associés de ce qui est fait"
          }
        }
      }
    },
    "Off": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé"
          }
        }
      }
    },
    "Only indoor cameras with consent in Transcription can listen. Outdoor and doorbell cameras never give orders. Staff mode pauses everything.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les caméras intérieures avec consentement dans Transcription peuvent écouter. Les caméras extérieures et la sonnette ne donnent jamais d’ordres. Le mode « personnel présent » met tout en pause."
          }
        }
      }
    },
    "Open": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir"
          }
        }
      }
    },
    "Paused (camera not eligible)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En pause (caméra non autorisée)"
          }
        }
      }
    },
    "Press “Get devices” to list what Home Assistant has.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur « Récupérer les appareils » pour lister ceux de Home Assistant."
          }
        }
      }
    },
    "Preview": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu"
          }
        }
      }
    },
    "Preview only (nothing is sent to the house)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu seulement (rien n’est envoyé à la maison)"
          }
        }
      }
    },
    "Preview only: no iPhone request was sent.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu seulement : aucune demande envoyée à l’iPhone."
