    "Use https, or a local network address.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez https, ou une adresse du réseau local."
          }
        }
      }
    },
    "Use the local AI model for unusual phrasing": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser le modèle d’IA local pour les tournures inhabituelles"
