    "Check the log": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifier le journal"
          }
        }
      }
    },
    "Children's voices can only use lights, TV, music and shutters.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les voix d’enfants peuvent seulement utiliser lumières, télé, musique et volets."
          }
        }
      }
    },
    "Children's voices: T0 only. A voice can only lower rights, never raise them. Say “no, cancel” within 10 seconds to undo.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voix d’enfants : T0 seulement. Une voix peut seulement réduire les droits, jamais les augmenter. Dites « non, annule » dans les 10 secondes pour défaire."
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer"
          }
        }
      }
    },
    "Confirmed on iPhone": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmé sur l’iPhone"
          }
        }
      }
    },
    "Connected": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecté"
          }
        }
      }
    },
    "Connecting…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion…"
          }
        }
      }
    },
    "Create the token in Home Assistant › Profile › Security. A user without admin rights is safer; rooms then need to be set here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez le jeton dans Home Assistant › Profil › Sécurité. Un utilisateur sans droits d’administration est plus sûr ; les pièces se règlent alors ici."
          }
        }
      }
    },
    "Delete the log": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer le journal"
          }
        }
      }
    },
    "Devices the assistant may use": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appareils que l’assistant peut utiliser"
          }
        }
      }
    },
    "Disarm": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactiver l’alarme"
          }
        }
      }
    },
    "Dismiss": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorer"
