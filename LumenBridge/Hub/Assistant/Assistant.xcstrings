      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pièces"
          }
        }
      }
    },
    "Safety": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sécurité"
          }
        }
      }
    },
    "Safety tier": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Niveau de sécurité"
          }
        }
      }
    },
    "Same request twice.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même demande deux fois."
          }
        }
      }
    },
    "Save": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer"
          }
        }
      }
    },
    "Say “Lumen, …” first": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dire « Lumen, … » d’abord"
          }
        }
      }
    },
    "Say “Lumen” then your request, for example “Lumen, turn on the living room light”.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites « Lumen » puis votre demande, par exemple « Lumen, allume la lumière du salon »."
          }
        }
      }
    },
    "Sent to iPhone": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyé à l’iPhone"
          }
        }
      }
    },
    "Set temperature": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Régler la température"
          }
        }
      }
    },
    "Simple French and English requests are understood by rules, instantly. The model is asked only when rules are unsure, and it can only pick from the devices you allowed.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les demandes simples en français et en anglais sont comprises par des règles, tout de suite. Le modèle n’est consulté que si les règles hésitent, et il ne peut choisir que parmi les appareils autorisés."
          }
        }
      }
    },
    "Sounded like the TV or music.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ressemblait à la télé ou à la musique."
          }
        }
      }
    },
    "Stop": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter"
          }
        }
      }
    },
    "Test": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tester"
          }
        }
      }
    },
    "The assistant log could not open.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le journal de l’assistant n’a pas pu s’ouvrir."
          }
        }
      }
    },
    "The log was changed outside Lumen Hub (chain broken).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le journal a été modifié hors de Lumen Hub (chaîne rompue)."
          }
        }
      }
    },
    "The token could not be saved in the Keychain.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeton n’a pas pu être enregistré dans le trousseau."
          }
        }
      }
    },
